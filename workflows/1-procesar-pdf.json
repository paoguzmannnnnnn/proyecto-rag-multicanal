    {
      "parameters": {
        "jsCode": "// Tomamos el texto del nodo anterior\nconst text = $json.text || \"\";\nconst words = text.split(/\\s+/).filter(Boolean);\nconst chunkSize = 500;\nconst chunks = [];\n\nfor (let i = 0; i < words.length; i += chunkSize) {\n  const chunkWords = words.slice(i, i + chunkSize);\n  chunks.push({\n    json: {\n      text: chunkWords.join(\" \"),\n      chunk_id: Math.floor(i / chunkSize),\n      doc_name: \"documento_ejemplo\"\n    }\n  });\n}\n\nreturn chunks;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "bfcbfb6c-17cc-4c18-86eb-7a63cacbe6ce",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api-inference.huggingface.co/models/sentence-transformers/all-MiniLM-L6-v2",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        624,
        0
      ],
      "id": "42717616-6327-4a02-80dd-d20c0c16a4c0",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "// Tomamos el resultado del nodo anterior\nconst hfResponse = $input.item.json;\n\n// Si el resultado es un array (como [ [0.23, -0.45, ...] ]), tomamos el primero\nconst vector = Array.isArray(hfResponse[0]) ? hfResponse[0] : hfResponse;\n\n// Creamos el formato que Pinecone necesita\nreturn [\n  {\n    json: {\n      id: `{{$json.doc_name}}_chunk_{{$json.chunk_id}}`,\n      values: vector,\n      metadata: {\n        text: $json.text,\n        doc_name: $json.doc_name,\n        chunk_id: $json.chunk_id\n      }\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
