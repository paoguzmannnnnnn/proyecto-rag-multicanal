    {
      "parameters": {
        "jsCode": "// Toma todos los items que llegan desde el Merge\nconst all = $input.all();\n\n// Busca un item que tenga resultados (hits/matches/documents)\nlet searchItem = null;\nlet passthroughItem = null;\n\nfor (const it of all) {\n  const j = it.json || {};\n  const hasHits = Array.isArray(j.hits) || Array.isArray(j.matches) || Array.isArray(j.documents) || Array.isArray(j.results) || Array.isArray(j.docs);\n  if (hasHits && !searchItem) searchItem = j;\n  // Detecta el passthrough por la presencia de chat_id/pregunta y ausencia de arreglos de resultados\n  const noHits = !Array.isArray(j.hits) && !Array.isArray(j.matches) && !Array.isArray(j.documents) && !Array.isArray(j.results) && !Array.isArray(j.docs);\n  if (noHits && (j.chat_id || j.pregunta)) passthroughItem = j;\n}\n\n// Rescata chat_id y query desde donde corresponda\nconst chatId = (searchItem?.chat_id ?? passthroughItem?.chat_id ?? \"\") + \"\";\nconst query  = (searchItem?.pregunta ?? passthroughItem?.pregunta ?? \"\") + \"\";\n\n// Extrae los docs (si los hay)\nconst buckets = [\n  searchItem?.hits,\n  searchItem?.matches,\n  searchItem?.results,\n  searchItem?.documents,\n  searchItem?.docs,\n];\nlet docs = [];\nfor (const b of buckets) if (Array.isArray(b) && b.length) { docs = b; break; }\n\n// Función para sacar texto del doc\nconst getText = d =>\n  (typeof d?.text === 'string' && d.text) ||\n  (typeof d?.content === 'string' && d.content) ||\n  (typeof d?.metadata?.text === 'string' && d.metadata.text) ||\n  \"\";\n\n// Construye el contexto top-3\nconst top = docs.slice(0, 3).map((d, i) => {\n  const t = (getText(d) || \"\").trim();\n  return t ? `Doc ${i+1}:\\n${t}` : null;\n}).filter(Boolean);\n\nconst context = top.length ? `Contexto (top ${top.length}):\\n\\n${top.join(\"\\n\\n\")}` : \"\";\n\n// Devuelve **un solo item** normalizado\nreturn [\n  {\n    json: {\n      chat_id: chatId,\n      query,\n      context,\n      found: top.length > 0,\n    },\n  },\n];"
      },
