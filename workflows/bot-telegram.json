    {
      "parameters": {
        "jsCode": "// Toma el primer item de entrada (webhook) y soporta body plano o anidado\nconst first = $input.first();\nconst raw = first?.json?.body ?? first?.json ?? {};\n\n// Soporta message / edited_message / callback_query\nconst message  = raw.message ?? raw.edited_message ?? null;\nconst callback = raw.callback_query ?? null;\n\n// Extrae chat_id de forma segura\nconst chatId =\n  message?.chat?.id ??\n  callback?.message?.chat?.id ??\n  null;\n\n// Extrae el texto (de mensaje normal o de botón)\nconst text =\n  (typeof message?.text === 'string' ? message.text : null) ??\n  (typeof callback?.data === 'string' ? callback.data : null) ??\n  \"\";\n\n// Normaliza\nconst pregunta   = (text || \"\").trim();\nconst esComando  = pregunta.startsWith('/');\nconst esValido   = Boolean(pregunta.length > 0 && !esComando);\n\n// Devuelve SIEMPRE un item (para que el flujo no se corte)\nreturn [\n  {\n    json: {\n      chat_id: chatId ?? \"\",\n      pregunta,\n      es_valido: esValido,\n      es_comando: esComando,\n      tipo_update: callback ? \"callback_query\" : (message ? \"message\" : \"unknown\"),\n    },\n  },\n];"
      },
